# ===================================================================
# Smart Lost & Found Recovery Platform - Environment Configuration
# ===================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_lost_found
DB_USERNAME=root
# Replace with your local MySQL password when running locally:
DB_PASSWORD=your_mysql_password_here

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Security Configuration
# Must be at least 256 bits (32+ alphanumeric characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Setup (Managed via Migration / CLI)
INITIAL_ADMIN_EMAIL=admin@smartlostfound.com
INITIAL_ADMIN_NAME=System Administrator
# Default bootstrap password (hashed with BCrypt in Flyway migration)
# Default password before change: Admin@123456
